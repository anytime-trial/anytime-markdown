{
  "name": "anytime-markdown-monorepo",
  "version": "1.21.2",
  "license": "MIT",
  "private": true,
  "scripts": {
    "version:sync": "npm version --no-git-tag-version --workspaces",
    "spec:index": "tsx scripts/gen-spec-index.mjs /Shared/anytime-markdown-docs/spec 設計書 ja",
    "tech:index": "tsx scripts/gen-spec-index.mjs /Shared/anytime-markdown-docs/tech 技術ドキュメント ja",
    "proposal:index": "tsx scripts/gen-spec-index.mjs /Shared/anytime-markdown-docs/proposal 提案 ja",
    "review:index": "tsx scripts/gen-spec-index.mjs /Shared/anytime-markdown-docs/review レビュー ja",
    "report:index": "tsx scripts/gen-spec-index.mjs /Shared/anytime-markdown-docs/report レポート ja",
    "plan:index": "tsx scripts/gen-spec-index.mjs /Shared/anytime-markdown-docs/plan プラン ja",
    "test:index": "tsx scripts/gen-spec-index.mjs /Shared/anytime-markdown-docs/test 試験設計書 ja",
    "manual:index": "tsx scripts/gen-spec-index.mjs docs/manual マニュアル ja",
    "check-skills": "node scripts/check-bundled-skills.mjs && node scripts/check-skill-refs.mjs && node scripts/check-skill-manifest-bump.mjs && node scripts/check-skill-inventory.mjs && node scripts/check-shortcut-markers.mjs && node scripts/check-test-collection.mjs && npm run test:scripts",
    "accept:farm": "node scripts/acceptance/farm.mjs",
    "test:scripts": "node --test scripts/*.test.mjs scripts/acceptance/*.test.mjs scripts/export-viewer-dist/*.test.mjs",
    "verify": "node scripts/run-verified.mjs",
    "verify:lint": "node scripts/run-verified.mjs monorepo lint -- npm run lint",
    "verify:scripts": "node scripts/run-verified.mjs monorepo unit -- npm run test:scripts",
    "verify:next-build": "node scripts/run-verified.mjs web-app next-build -- npm run build -w @anytime-markdown/web-app",
    "verify:ext-build": "node scripts/run-verified.mjs vscode-graph-extension build -- npm run compile -w anytime-graph",
    "verify:gate": "npm run verify:next-build && npm run verify:ext-build",
    "postinstall": "rm -rf node_modules/next-auth/node_modules/@auth",
    "lint": "eslint packages/markdown-editor/src packages/web-app/src",
    "lint:fix": "eslint --fix packages/markdown-editor/src packages/web-app/src",
    "prepare": "husky && node scripts/install-extra-hooks.mjs"
  },
  "workspaces": [
    "packages/markdown-editor",
    "packages/markdown-rich-editor",
    "packages/markdown-view",
    "packages/markdown-view-lite",
    "packages/markdown-react-islands",
    "packages/browser-extension",
    "packages/markdown-core",
    "packages/spreadsheet-core",
    "packages/spreadsheet-viewer",
    "packages/chart-core",
    "packages/graph-react-islands",
    "packages/database-core",
    "packages/database-viewer",
    "packages/graph-core",
    "packages/ui-core",
    "packages/mcp-markdown",
    "packages/mcp-graph",
    "packages/cms-core",
    "packages/mcp-cms",
    "packages/mcp-cms-remote",
    "packages/vscode-common",
    "packages/vscode-markdown-extension",
    "packages/vscode-graph-extension",
    "packages/vscode-database-extension",
    "packages/vscode-sheet-extension",
    "packages/vscode-trail-extension",
    "packages/vscode-agent-extension",
    "packages/vscode-history-extension",
    "packages/vscode-extension-pack",
    "packages/web-app",
    "packages/trail-server",
    "packages/code-analysis-core",
    "packages/code-analysis-typescript",
    "packages/code-analysis-python",
    "packages/trail-activity",
    "packages/trail-db",
    "packages/tickets-core",
    "packages/tickets-viewer",
    "packages/trail-viewer",
    "packages/graph-viewer",
    "packages/cooccurrence-viewer",
    "packages/mcp-trail",
    "packages/trace-core",
    "packages/trace-agent-node",
    "packages/trace-viewer",
    "packages/trail-caravan-book",
    "packages/markdown-catalog",
    "packages/llm-core",
    "packages/ollama-core",
    "packages/agent-core",
    "packages/review-agent",
    "packages/markdown-eval-core",
    "packages/section-lock-core"
  ],
  "overrides": {
    "ip-address": "10.4.0",
    "fast-uri": "3.1.5",
    "serialize-javascript": "7.0.5",
    "diff": "8.0.3",
    "postcss": "8.5.25",
    "uuid": "^14.0.0",
    "next": "16.2.12",
    "@auth/core": "0.41.3",
    "next-auth": {
      "@auth/core": "0.41.3"
    },
    "handlebars": "4.7.9",
    "@xmldom/xmldom": "0.9.10",
    "brace-expansion": "1.1.18",
    "ignore": "7.0.5",
    "ws": "8.21.0",
    "markdown-it": "14.2.0",
    "linkify-it": "5.0.2",
    "dompurify": "3.4.13",
    "sharp": "0.35.3",
    "nanoid": "3.3.18",
    "gray-matter": {
      "js-yaml": "3.15.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    }
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "4.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "raw-loader": "4.0.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0"
  },
  "lint-staged": {
    "packages/markdown-editor/src/**/*.{ts,tsx}": "eslint",
    "packages/web-app/src/**/*.{ts,tsx}": "eslint"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@xmldom/xmldom": "0.9.10",
    "ignore": "7.0.5",
    "next": "16.2.12"
  }
}
