{
  "name": "@anytime-markdown/markdown-editor",
  "version": "1.21.0",
  "description": "Markdown エディタ基盤（TipTap 拡張の組み立て・mount API・vanilla UI・i18n・ファイルシステム抽象）。markdown-rich-editor / markdown-react-islands / markdown-view-lite が依存する土台。図表描画は含まない（markdown-rich-editor が担う）。",
  "license": "MIT",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./i18n/messages": "./src/i18n/index.ts",
    "./i18n/translator": "./src/i18n/createMarkdownT.ts",
    "./element": "./src/element.ts",
    "./view-element": "./src/view-element.ts",
    "./settings": "./src/editorSettings.ts",
    "./embed-providers": "./src/embedProviders.ts",
    "./host/mount": "./src/host/vanillaMarkdownEditor.ts",
    "./host/file-ops": "./src/host/fileOpsController.ts",
    "./host/live-update-diff": "./src/host/liveUpdateDiff.ts",
    "./types/embed-provider": "./src/types/embedProvider.ts",
    "./types/toolbar": "./src/types/toolbar.ts",
    "./types/dialog": "./src/providers/types.ts",
    "./constants/storage-keys": "./src/constants/storageKeys.ts",
    "./utils/measure-preset": "./src/utils/measurePreset.ts",
    "./utils/draft-storage": "./src/utils/draftStorage.ts",
    "./utils/tweet-sanitize": "./src/utils/tweetSanitize.ts",
    "./utils/rss-parser": "./src/utils/rssParser.ts",
    "./fs/web-file-system-provider": "./src/fs/webFileSystemProvider.ts",
    "./fs/drive-client": "./src/fs/driveClient.ts",
    "./fs/drive-file-system-provider": "./src/fs/driveFileSystemProvider.ts",
    "./web-import/provider": "./src/webImport/webImportProvider.ts",
    "./web-import/capture-page": "./src/webImport/capturePage.ts",
    "./internal/*": "./src/*"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "jest"
  },
  "dependencies": {
    "@anytime-markdown/markdown-core": "*",
    "@anytime-markdown/section-lock-core": "*",
    "@anytime-markdown/spreadsheet-viewer": "*",
    "@anytime-markdown/ui-core": "*",
    "@mozilla/readability": "0.6.0",
    "@xmldom/xmldom": "0.9.10",
    "encoding-japanese": "2.2.0",
    "lowlight": "3.3.0",
    "stylis": "4.2.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "peerDependencies": {
    "diff": "^8.0.3",
    "dompurify": "^3.0.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.7.6",
    "@types/diff": "7.0.2",
    "@types/dompurify": "3.0.5",
    "@types/encoding-japanese": "2.2.1",
    "@types/jest": "30.0.0",
    "@types/katex": "0.16.0",
    "@types/plantuml-encoder": "1.4.2",
    "@types/turndown": "5.0.5",
    "esbuild": "0.27.3",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "ts-jest": "29.4.11"
  }
}
