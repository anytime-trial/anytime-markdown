{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "noEmit": true,
    "isolatedModules": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@anytime-markdown/markdown-engine": ["../markdown-engine/src/index.ts"],
      "@anytime-markdown/markdown-editor/internal/*": ["../markdown-editor/src/*"]
    }
  },
  "include": ["src/**/*"]
}
