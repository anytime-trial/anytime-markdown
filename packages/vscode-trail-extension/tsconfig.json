{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "outDir": "out",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "jest"],
    "paths": {
      "@anytime-markdown/trail-activity": ["../trail-activity/src/index.ts"],
      "@anytime-markdown/trail-db": ["../trail-db/src/index.ts"],
      "@anytime-markdown/trail-db/*": ["../trail-db/src/*"],
      "@anytime-markdown/trail-activity/*": ["../trail-activity/src/*"],
      "@anytime-markdown/graph-core": ["../graph-core/src/index.ts"],
      "@anytime-markdown/graph-core/*": ["../graph-core/src/*"],
      "@anytime-markdown/trail-viewer": ["../trail-viewer/src/index.ts"],
      "@anytime-markdown/trail-viewer/*": ["../trail-viewer/src/*"],
      "@anytime-markdown/trace-core/c4Sequence": ["../trace-core/src/c4Sequence.ts"],
      "@anytime-markdown/trail-caravan-book": ["../trail-caravan-book/src/index.ts"],
      "@anytime-markdown/agent-core": ["../agent-core/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/c4/webview/**/*"]
}
