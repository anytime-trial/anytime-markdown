{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    // "paths" は extends で継承マージされず全置換されるため、tsconfig.json の既存分もここへ複製する。
    // next-intl は ESM-only（"exports" に require 条件が無い）で、module:Node16 の CommonJS プログラムからは
    // 直接 import できない（TS1479）。tickets-viewer のコンポーネント群が next-intl を直接 import しており、
    // rpcGateway のテストが barrel 経由でそれらを型検査対象へ引き込むため、webpack alias / jest moduleNameMapper と
    // 同じ実体（このパッケージの next-intl shim）へ型レベルでも差し替える。
    "paths": {
      "@anytime-markdown/tickets-core": ["../tickets-core/src/index.ts"],
      "@anytime-markdown/vscode-common": ["../vscode-common/src/index.ts"],
      "next-intl": ["./src/webview/shims/next-intl.ts"],
      "next-intl/server": ["./src/webview/shims/next-intl.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/webview/**"]
}
